{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "cli/bin/cli.ts",
    "scripts/lib/transformers/*.ts",
    "scripts/lib/skill-categories.ts",
    "tests/typescript-contracts.ts"
  ]
}
